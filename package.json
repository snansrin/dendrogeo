{
  "name": "dendrogeo",
  "version": "3.0.0",
  "private": true,
  "description": "DendroGeo — Küresel Ağaç Envanteri ve Karbon Veri Sistemi",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "build": "node scripts/build-index.mjs --write",
    "build:check": "node scripts/build-index.mjs --check",
    "check:csp": "node scripts/check-csp.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:versions": "node scripts/version-sync.mjs --check",
    "check": "npm run check:syntax && npm run check:versions && npm run build:check && npm run check:csp && npm test"
  },
  "engines": {
    "node": ">=20"
  },
