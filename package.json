{
  "name": "dendrogeo",
  "version": "3.0.0",
  "private": true,
  "description": "DendroGeo — Küresel Ağaç Envanteri ve Karbon Veri Sistemi",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "build": "node scripts/sync-runtime-precache.mjs --write && node scripts/build-index.mjs --write",
    "build:check": "node scripts/sync-runtime-precache.mjs --check && node scripts/build-index.mjs --check",
    "check:csp": "node scripts/check-csp.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:versions": "node scripts/version-sync.mjs --check",
    "check:core-foundation": "node scripts/check-core-foundation.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:inline-events": "node scripts/check-inline-events.mjs",
    "check:generated-events": "node scripts/check-generated-markup-handlers.mjs",
    "architecture:status:write": "node scripts/architecture-status.mjs --write",
    "check:architecture-status": "node scripts/architecture-status.mjs --check",
    "check:service-boundaries": "node scripts/check-service-boundaries.mjs",
    "check:dependencies": "node scripts/check-dependency-rules.mjs",
    "check": "npm run check:core-foundation && npm run check:architecture && npm run check:service-boundaries && npm run check:dependencies && npm run check:inline-events && npm run check:generated-events && npm run check:modules && npm run check:syntax && npm run check:versions && npm run build:check && npm run check:csp && npm test && npm run check:architecture-status",
    "check:modules": "node scripts/check-module-integration.mjs",
    "check:phone": "node scripts/check-phone.mjs",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "check:sql": "node --test test/measurement-postgres-contract.test.mjs",
    "check:release": "npm run check && npm run check:phone && npm run check:accessibility"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "CC-BY-NC-4.0",
  "author": "Nagihan ŞİRİN & Sinan ŞİRİN",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "acorn": "8.19.0",
    "axe-core": "4.14.0",
    "jose": "6.1.0",
    "playwright-core": "1.62.1",
    "polygon-clipping": "0.15.7",
    "qrcode": "^1.5.4"
  }
}
