+    const t = { then: (res) => res(RESULTS[table] || { data: [], error: null }) };
+    for (const m of ['select', 'eq', 'order', 'limit', 'is', 'update', 'insert'])
+      t[m] = (...a) => { calls.push([table, m, a]); return t; };
